# TikTok Login Kit credentials
# Copy this file to .env.local for local development
# On Netlify, add these in Site settings → Environment variables

TIKTOK_CLIENT_KEY=your_client_key_here
TIKTOK_CLIENT_SECRET=your_client_secret_here
TIKTOK_REDIRECT_URI=https://tiktok-integration-website.netlify.app/api/auth/tiktok/callback

# Session secret for production cookies (generate a long random string)
SESSION_SECRET=change_me_to_a_long_random_string
